            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a363"
                TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>нуу</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a364"
                TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts765">
                <ANNOTATION_VALUE>почему Москва</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a365"
                TIME_SLOT_REF1="ts766" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>потому что м= мне кажется что здесь / больше перспектив / эээ / чем в Санкт-Петербурге</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a366"
                TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts795">
                <ANNOTATION_VALUE>и / вообще / после Москвы / когда приезж= приезжаешь в Санкт-Петербург</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a368"
                TIME_SLOT_REF1="ts796" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>кажется что / как бы столица / основная она развивается</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a369"
                TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>а столица северная / она как будто бы застряла в нулевых</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a370"
                TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>и это очень грустно на самом деле</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a374"
                TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>я пожелаю ей / эээ таких руководителей</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a375"
                TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts867">
                <ANNOTATION_VALUE>у которых будет / достаточное количество политической воли</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a376"
                TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>чтобы начать эээ масштабные изменения / в городе и пригородах</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a377"
                TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>потому что конечно / так долго продолжаться не может</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a378"
                TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>и если не решать / существующие проблемы сейчас</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a379"
                TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>то потом их будет решать сложнее и дороже</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380"
                TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts937">
                <ANNOTATION_VALUE>поэтому нужна политическая воля / эээ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381"
                TIME_SLOT_REF1="ts938" TIME_SLOT_REF2="ts951">
                <ANNOTATION_VALUE>все эти разговоры про то что все деньги в Москве / это всё</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382"
                TIME_SLOT_REF1="ts952" TIME_SLOT_REF2="ts963">
                <ANNOTATION_VALUE>ну мне кажется неправильным потому что дело не только в деньгах</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a383"
                TIME_SLOT_REF1="ts964" TIME_SLOT_REF2="ts969">
                <ANNOTATION_VALUE>но и в качестве управления</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384"
                TIME_SLOT_REF1="ts970" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>и как мне кажется оно недостаточно высокое / в нашей культурной столице</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
